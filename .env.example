# ============================================================
# explorecipe · 本地环境变量模板
# 实际使用时复制为 .env，填入真实密钥；.env 不会进 git
# ============================================================

# —— 图像生成（gpt-image-2，任何 OpenAI 兼容反代均可）——
# 自部署官方 OpenAI、Azure OpenAI、或第三方反代均可
IMAGE_API_KEY=sk-填入-image-key
IMAGE_UPSTREAM_URL=https://your-openai-compatible-proxy.example/v1/images/edits
IMAGE_MODEL=gpt-image-2
# 1024x1536 (2:3) / 1024x1792 (9:16)；v2 默认 9:16
IMAGE_SIZE=1024x1536
IMAGE_SIZE_V2=1024x1792

# —— StepFun 视觉对话（v1 用：写科普卡）——
# 注：v2 「无限分解」已由 Gemini 接管，StepFun 仅 v1 server.py 需要
STEPFUN_API_KEY=填入-stepfun-key
STEPFUN_BASE_URL=https://api.stepfun.com/v1
STEPFUN_MODEL=step-3.6

# —— Gemini（v2 用：入口审核+识菜名合并 + 提取 layers + 写 brief）——
# 从 https://aistudio.google.com/apikey 申请 free-tier
# 国内服务器无法直连 Google 时，可走 OpenAI 兼容中转（修改 GEMINI_BASE_URL）
# 入口审核（拦截非食物图）由这个模型一次性完成，无需额外审核模型
GEMINI_API_KEY=填入-google-aistudio-key
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# 审核 fail-open 阈值：极个别上游抖动时，confidence 低于此值的"not_food"放行
AUDIT_FAIL_OPEN_BELOW=0.5

# —— 服务监听 ——
# 本地开发用 :: 双栈；生产用 127.0.0.1 由 nginx 反代
# v1 端口
BIND_HOST=::
PORT=18082
# v2 端口（开发时与 v1 隔离，生产环境若只跑 v2 直接复用 18082 即可）
BIND_HOST_V2=::
PORT_V2=18083

# —— 公开域名（OG meta、永久分享卡的二维码会用到）——
PUBLIC_BASE_URL_V2=http://localhost:18083
