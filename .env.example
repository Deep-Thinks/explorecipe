# ============================================================
# explorecipe · 本地环境变量模板
# 实际使用时复制为 .env，填入真实密钥；.env 不会进 git
# ============================================================

# —— 图像生成（dm-fox 反代，沿用 lilibear-world 同一把 key）——
IMAGE_API_KEY=sk-填入-dm-fox-key

# —— StepFun 视觉对话（step-3.6 视觉模式，写科普卡）——
STEPFUN_API_KEY=填入-stepfun-内测-key
STEPFUN_BASE_URL=https://api.stepfun.com/v1
STEPFUN_MODEL=step-3.6

# —— 服务监听 ——
# 本地开发用 :: 双栈；生产用 127.0.0.1 由 nginx 反代
BIND_HOST=::
PORT=18081
