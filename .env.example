# ============================================================
# explorecipe · 本地环境变量模板
# 实际使用时复制为 .env，填入真实密钥；.env 不会进 git
# ============================================================

# —— 图像生成（dm-fox 反代，沿用 lilibear-world 同一把 key）——
IMAGE_API_KEY=sk-填入-dm-fox-key

# —— StepFun 视觉对话（step-3.6 视觉模式，写科普卡）——
# 注：「无限分解」功能上线后将由 Gemini 3 Flash 接管视觉识别；StepFun 暂保留兼容
STEPFUN_API_KEY=填入-stepfun-内测-key
STEPFUN_BASE_URL=https://api.stepfun.com/v1
STEPFUN_MODEL=step-3.6

# —— Gemini 3 Flash（无限分解：每层识别"红框内是什么"）——
# free-tier 从 https://aistudio.google.com/apikey 申请
GEMINI_API_KEY=填入-google-aistudio-key
GEMINI_MODEL=gemini-3-flash-preview

# —— 内容审核（MiniCPM-V 1.3B 多模态小模型）——
# 在 gpt-image-2 前做 is_food 二分类，拦截人物/文档/建筑等非食物图。
# 紧急关闭：MODERATION_ENABLED=false（用于审核上游故障时让业务先恢复，需重启服务生效）
MINICPM_BASE_URL=https://llm-center.ali.modelbest.cn/llm
MINICPM_API_KEY=填入-modelbest-llm-center-key
MINICPM_MODEL=MINICPM_23u6wt
MODERATION_ENABLED=true

# —— 服务监听 ——
# 本地开发用 :: 双栈；生产用 127.0.0.1 由 nginx 反代
# PORT 与生产 nginx vhost (deploy/nginx-explorecipe.conf) 反代目标 18082 必须一致
BIND_HOST=::
PORT=18082
